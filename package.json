{
  "build": {
    "appId": "com.krunggggggg.stragis",
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "client/dist/**/*",
      "server/dist/**/*",
      "drizzle/**/*",
      "electron/**/*",
      "package.json"
    ],
    "npmRebuild": true,
    "productName": "Stragis",
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^2.15.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.13",
    "tailwindcss-safe-area": "^1.3.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.0"
  },
  "main": "electron/main.cjs",
  "name": "stragis",
  "private": true,
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/src/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=server/dist/server.mjs --external:better-sqlite3",
    "dev": "npm run build && npm run start",
    "dev:client": "vite",
    "dist:win": "npm run build && electron-builder --win portable",
    "start": "node server/dist/server.mjs",
    "typecheck": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "type": "module",
  "version": "1.0.0",
  "description": "Stragis \u2014 Understand the Trend. Trade With a Plan. Live crypto trading analysis + GOLD ONLY XAU/USD section (standalone + Electron desktop).",
  "author": "Karen Nipin (krunggggggg)"
}